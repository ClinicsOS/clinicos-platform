NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ClinicOS Connect realtime (Phase C3) — optional. The socket connects to the host of NEXT_PUBLIC_API_URL (path /socket.io).
# "websocket" = WebSocket only (needed behind a multi-instance load balancer that has no sticky sessions). Default: polling handshake, then WebSocket.
# NEXT_PUBLIC_CONNECT_TRANSPORTS=websocket

# Google Analytics — optional. When unset no analytics script is rendered (Phase 6 fix: it used to load with id "undefined").
# NEXT_PUBLIC_GA_ID=
